# Copy this file to .env and change what you need. .env is in .gitignore, so your keys stay on your machine.

# Local Postgres and Redis (from `docker compose up -d db redis mailpit`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing
REDIS_URL=redis://localhost:6379/0

# Signs login cookies. Any long random string. Make a new one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-not-for-production-use

# Where the React app runs (used to build pay links)
FRONTEND_URL=http://localhost:5173

# Payments. Empty = the fake gateway (every payment "succeeds", no money moves).
# Paystack test keys start with sk_test_ (dashboard.paystack.com > Settings > API Keys).
PAYSTACK_SECRET_KEY=

# AI. Empty = simple templates. Free Gemini key, no card: https://aistudio.google.com/apikey
AI_API_KEY=

# Emails: console (printed in the terminal) or smtp (Mailpit at http://localhost:8025)
EMAIL_BACKEND=console
